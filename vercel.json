{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "elementtl.vercel.app"
        }
      ],
      "destination": "https://elementlaser.co.kr/:path",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/beard-sessions.html",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/gen2-three-wavelengths.html",
      "destination": "/blog.html",
      "permanent": true
    },
    {
      "source": "/blog/redness-532.html",
      "destination": "/blog.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(js|css)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(img|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
